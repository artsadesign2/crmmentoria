# Neon PostgreSQL Database Credentials
NEON_HOST=your-neon-endpoint.neon.tech
NEON_USER=neondb_owner
NEON_PASS=your-password
NEON_DB=neondb

# Prisma Database URL
DATABASE_URL=postgresql://${NEON_USER}:${NEON_PASS}@${NEON_HOST}/${NEON_DB}?sslmode=require

# ---------------------------------------------------------------------------
# Auth (F0) — segredo de assinatura da sessao. Minimo 32 caracteres.
# Gerar com: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Senha inicial atribuida aos usuarios criados por `npm run db:seed`
SEED_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Evolution API — variaveis de SERVIDOR. Nunca usar prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Google Gemini — usado a partir da F4
GEMINI_API_KEY=

# Segredo do webhook da Evolution (F3). A rota nao aceita nada sem ele.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Configure na Evolution: https://seu-dominio/api/webhook/whatsapp?token=<valor>
EVOLUTION_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# E-mail transacional (F5) — usado pela recuperacao de senha.
# Sem RESEND_API_KEY o codigo sai no log do servidor com aviso, nunca em
# silencio. Chave em https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Precisa ser de dominio verificado no Resend. Ex.: Rocket Club <nao-responda@seudominio.com>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Fila de disparo (F5) — segredo do endpoint do worker (/api/cron/dispatch).
# Sem ele a rota nao aceita nada: e um endpoint que ENVIA mensagens.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# O vercel.json agenda uma passada diaria as 11h UTC (08h em Sao Paulo, inicio
# da janela de envio) — funciona ate no plano Hobby. A tela de disparo tambem
# chama este endpoint enquanto estiver aberta, e chamadas simultaneas sao
# seguras: a fila usa FOR UPDATE SKIP LOCKED.
# ---------------------------------------------------------------------------
CRON_SECRET=
