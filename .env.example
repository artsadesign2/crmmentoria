# Neon PostgreSQL Database Credentials
NEON_HOST=your-neon-endpoint.neon.tech
NEON_USER=neondb_owner
NEON_PASS=your-password
NEON_DB=neondb

# Prisma Database URL
DATABASE_URL=postgresql://${NEON_USER}:${NEON_PASS}@${NEON_HOST}/${NEON_DB}?sslmode=require

# ---------------------------------------------------------------------------
# Auth (F0) — segredo de assinatura da sessao. Minimo 32 caracteres.
# Gerar com: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Senha inicial atribuida aos usuarios criados por `npm run db:seed`
SEED_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Evolution API — variaveis de SERVIDOR. Nunca usar prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Google Gemini — usado a partir da F4
GEMINI_API_KEY=
