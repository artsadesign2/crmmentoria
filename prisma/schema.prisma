// ---------------------------------------------------------------------------
// ATENÇÃO: este schema reflete o banco REAL, obtido por introspecção.
//
// O banco foi criado por lib/neon-db.ts com SQL cru e usa snake_case. Um
// schema.prisma anterior descrevia uma estrutura que nunca foi aplicada;
// `prisma db push` teria destruído os dados. Ele permanece no histórico do git.
//
// REGRA: NÃO rode `prisma db push` neste projeto. Alterações de estrutura vão
// em prisma/migrations/<nome>/migration.sql, escritas à mão e idempotentes,
// aplicadas por um runner próprio (npm run db:migrate <nome>).
//
// Os models de autenticação abaixo usam camelCase com @map, porque o código
// TypeScript os consome. Os demais mantêm snake_case da introspecção: ainda são
// servidos por SQL cru e serão convertidos quando cada fase os alcançar.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(200)
  slug            String           @unique @db.VarChar(100)
  domain          String?          @db.VarChar(200)
  plan            String           @default("STARTER") @db.VarChar(20)
  logoUrl         String?          @map("logo_url")
  primaryColor    String           @default("#EAB308") @map("primary_color") @db.VarChar(20)
  features        Json             @default("{\"wiki\": true, \"events\": true, \"kanban\": true, \"academy\": true, \"financial\": true}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  departments     Department[]
  rolePermissions RolePermission[]
  users           User[]

  // F1 — CRM
  pipelines     Pipeline[]
  contacts      Contact[]
  dealCards     DealCard[]
  tags          Tag[]
  activityLogs  ActivityLog[]
  conversations Conversation[]
  messages      Message[]

  // F4 — IA
  aiSettings    AiSettings?

  @@map("organizations")
}

model User {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  email          String  @db.VarChar(150)
  /// bcrypt. Os hashes existentes vêm do password_hash() do PHP, com prefixo
  /// $2y$ — o bcryptjs valida esse prefixo, então as senhas atuais continuam válidas.
  passwordHash   String  @map("password_hash") @db.VarChar(255)
  name           String  @db.VarChar(150)
  /// MASTER | ADMINISTRADOR | EDITOR | CLIENTE | USUARIO.
  /// VARCHAR em vez de enum do PostgreSQL para não quebrar a camada de SQL cru
  /// que ainda escreve nesta tabela. A conversão para UserRole da interface fica
  /// em lib/auth/roles.ts, que é o único ponto que conhece os dois vocabulários.
  role           String  @default("USUARIO") @db.VarChar(20)
  phone          String? @db.VarChar(50)
  avatarUrl      String? @map("avatar_url")
  /// ATIVO | INATIVO | BLOQUEADO
  status         String  @default("ATIVO") @db.VarChar(20)
  /// O Master principal não pode ser excluído nem rebaixado.
  isPrimaryMaster Boolean   @default(false) @map("is_primary_master")
  lastActiveAt    DateTime? @map("last_active_at") @db.Timestamp(6)
  departmentId    String?   @map("department_id") @db.Uuid
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department          Department?          @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  passwordResetTokens PasswordResetToken[]
  academy_comments    AcademyComment[]
  user_permissions    user_permissions[]
  wiki_articles       WikiArticle[]

  // F1 — CRM
  assignedDealCards     DealCard[]
  activityLogs          ActivityLog[]
  assignedConversations Conversation[]
  messages              Message[]

  /// Escopado por organização: o mesmo e-mail pode existir em tenants distintos.
  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// O código de 6 dígitos nunca é gravado em texto claro.
  codeHash  String    @map("code_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt], map: "password_reset_tokens_user_expires_idx")
  @@map("password_reset_tokens")
}

model RolePermission {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  role           String @db.VarChar(20)
  /// As 46 chaves de RolePermissions. Json de propósito: a tela de configurações
  /// as edita em bloco e elas crescem a cada módulo novo do produto.
  permissions    Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, role])
  @@map("role_permissions")
}

model Member {
  id                         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String             @db.VarChar(200)
  specialty                  String?
  status                     String             @default("amarela") @db.VarChar(20)
  last_contact               DateTime?          @db.Date
  notes                      String?
  position                   Int?               @default(0)
  created_at                 DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?          @default(now()) @db.Timestamp(6)
  age                        String?            @db.VarChar(50)
  birthdate                  DateTime?          @db.Date
  birthplace                 String?            @db.VarChar(200)
  residence                  String?            @db.VarChar(200)
  phone                      String?            @db.VarChar(50)
  instagram                  String?            @db.VarChar(200)
  email                      String?            @db.VarChar(150)
  interests                  String?
  hobbies                    String?
  cover_image                String?
  cpf                        String?            @db.VarChar(50)
  rg                         String?            @db.VarChar(50)
  professional_register      String?            @db.VarChar(300)
  marital_status             String?            @db.VarChar(100)
  register_pj                String?            @db.VarChar(100)
  cnpj                       String?            @db.VarChar(50)
  company_name               String?            @db.VarChar(200)
  trade_name                 String?            @db.VarChar(200)
  municipal_register         String?            @db.VarChar(50)
  commercial_address         String?            @db.VarChar(300)
  nationality                String?            @db.VarChar(200)
  social_media               String?
  website                    String?            @db.VarChar(200)
  professional_experience    String?
  work_locations             String?
  work_description_hours     String?
  monthly_revenue            String?
  mentorship_interest        String?
  main_goal                  String?
  biggest_challenge          String?
  content_consumption        String?
  weekly_availability        String?
  how_did_you_find_us        String?
  spouse_info                String?
  children_info              String?
  pets_info                  String?
  emergency_contact          String?
  sports_info                String?
  exclude_from_book          Boolean?           @default(false)
  linkedin                   String?            @db.VarChar(200)
  facebook                   String?            @db.VarChar(200)
  youtube                    String?            @db.VarChar(200)
  twitter                    String?            @db.VarChar(200)
  membership_start_date      DateTime?          @db.Date
  membership_expiration_date DateTime?          @db.Date
  contract_value             Decimal?           @db.Decimal(10, 2)
  plan_name                  String?            @db.VarChar(100)
  card_template_model        String?            @db.VarChar(50)
  card_photo_align           String?            @db.VarChar(50)
  members_book_model         String?            @db.VarChar(50)
  academy_comments           AcademyComment[]
  academy_progress           academy_progress[]
  contact_log                contact_log[]
  goals                      Goal[]
  member_deals               member_deals[]
  milestones                 Milestone[]
  status_history             status_history[]

  @@index([email], map: "idx_members_email")
  @@index([status, position, name], map: "idx_members_status_pos_name")
  @@map("members")
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id   String    @db.Uuid
  pillar      Int
  title       String    @db.VarChar(300)
  description String?
  achieved_at DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  members     Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([member_id], map: "idx_milestones_member")
  @@map("milestones")
}

model Goal {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id    String    @db.Uuid
  pillar       Int
  title        String    @db.VarChar(300)
  description  String?
  status       String?   @default("open") @db.VarChar(20)
  due_date     DateTime? @db.Date
  completed_at DateTime? @db.Date
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  members      Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([member_id], map: "idx_goals_member")
  @@map("goals")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  isFixed        Boolean? @default(false) @map("is_fixed")
  /// Setor por onde entram as conversas novas do WhatsApp. Com número central e
  /// sem bot, não há como perguntar ao cliente com quem ele quer falar: a
  /// conversa nasce aqui e o atendente transfere se for o caso.
  ///
  /// O banco garante no máximo um por organização com um índice único parcial
  /// (`departments_default_inbox_key`), que o Prisma não sabe declarar — ele
  /// vive na migração f3-inbox.
  isDefaultInbox Boolean  @default(false) @map("is_default_inbox")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         User[]
  wiki_articles WikiArticle[]

  // F1 — CRM
  dealCards     DealCard[]
  conversations Conversation[]

  /// Era unique global antes da F3: duas organizações não podiam ter um setor
  /// "Comercial" cada uma.
  @@unique([organizationId, name], map: "departments_org_name_key")
  @@map("departments")
}

model WikiArticle {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String      @db.VarChar(200)
  content       String
  department_id String?     @db.Uuid
  is_public     Boolean?    @default(false)
  created_by    String?     @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @default(now()) @db.Timestamp(6)
  users         User?       @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  departments   Department? @relation(fields: [department_id], references: [id], onUpdate: NoAction)

  @@index([department_id, is_public], map: "idx_wiki_articles_dept")
  @@map("wiki_articles")
}

model AcademyCourse {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String          @db.VarChar(250)
  description     String?
  category        String?         @default("Geral") @db.VarChar(100)
  cover_image     String?
  banner_image    String?
  status          String?         @default("published") @db.VarChar(20)
  position        Int?            @default(0)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at      DateTime?       @default(now()) @db.Timestamp(6)
  level           String?         @default("Geral") @db.VarChar(50)
  academy_modules AcademyModule[]

  @@map("academy_courses")
}

model AcademyModule {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id       String          @db.Uuid
  title           String          @db.VarChar(250)
  description     String?
  position        Int?            @default(0)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  academy_lessons AcademyLesson[]
  academy_courses AcademyCourse   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id, position], map: "idx_academy_modules_course")
  @@map("academy_modules")
}

model AcademyLesson {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id        String             @db.Uuid
  title            String             @db.VarChar(250)
  description      String?
  video_provider   String?            @default("youtube") @db.VarChar(30)
  video_url        String?
  duration_seconds Int?               @default(0)
  attachments      String?
  position         Int?               @default(0)
  is_free_preview  Boolean?           @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  cover_image      String?
  academy_comments AcademyComment[]
  academy_modules  AcademyModule      @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academy_progress academy_progress[]

  @@index([module_id, position], map: "idx_academy_lessons_module")
  @@map("academy_lessons")
}

model AcademyComment {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id              String           @db.Uuid
  user_id                String?          @db.Uuid
  member_id              String?          @db.Uuid
  parent_id              String?          @db.Uuid
  content                String
  created_at             DateTime?        @default(now()) @db.Timestamp(6)
  updated_at             DateTime?        @default(now()) @db.Timestamp(6)
  academy_lessons        AcademyLesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members                Member?          @relation(fields: [member_id], references: [id], onUpdate: NoAction)
  academy_comments       AcademyComment?  @relation("academy_commentsToacademy_comments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_academy_comments AcademyComment[] @relation("academy_commentsToacademy_comments")
  users                  User?            @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([lesson_id, created_at], map: "idx_academy_comments_lesson")
  @@map("academy_comments")
}

model FinancialTransaction {
  id                String    @id @default(uuid()) @db.VarChar(100)
  description       String
  amount            Decimal   @default(0) @db.Decimal(12, 2)
  type              String    @default("INCOME") @db.VarChar(20)
  category          String    @default("Mensalidade") @db.VarChar(100)
  status            String    @default("PAID") @db.VarChar(30)
  date              DateTime  @default(now()) @db.Timestamptz(6)
  due_date          DateTime? @db.Timestamptz(6)
  member_id         String?   @db.VarChar(100)
  member_name       String?   @db.VarChar(255)
  gateway           String?   @default("MANUAL") @db.VarChar(50)
  payment_link      String?
  pix_copia_cola    String?
  pix_qrcode_base64 String?
  invoice_url       String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@map("financial_transactions")
}

model Event {
  id                String    @id @default(uuid()) @db.VarChar(100)
  title             String
  description       String?
  location          String?
  event_date        DateTime  @db.Timestamptz(6)
  end_date          DateTime? @db.Timestamptz(6)
  time_info         String?   @db.VarChar(50)
  attendees_count   Int?      @default(0)
  max_attendees     Int?      @default(100)
  ticket_price      Decimal?  @default(0) @db.Decimal(12, 2)
  status            String?   @default("UPCOMING") @db.VarChar(30)
  banner_image      String?
  confirmed_members String?   @default("[]")
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@map("events")
}

model academy_progress {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id           String        @db.Uuid
  lesson_id           String        @db.Uuid
  completed           Boolean?      @default(true)
  last_watched_second Int?          @default(0)
  notes               String?
  updated_at          DateTime?     @default(now()) @db.Timestamp(6)
  academy_lessons     AcademyLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members             Member        @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([member_id, lesson_id], map: "unique_member_lesson")
  @@index([member_id, lesson_id], map: "idx_academy_progress_member")
}

model contact_log {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id      String    @db.Uuid
  type           String?   @default("message") @db.VarChar(50)
  note           String?
  contact_date   DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  author_name    String?   @db.VarChar(255)
  follow_up_date DateTime? @db.Date
  members        Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([member_id, contact_date(sort: Desc)], map: "idx_contact_log_member_date")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model login_attempts {
  ip           String    @db.VarChar(50)
  email        String    @db.VarChar(150)
  attempted_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([email, ip, attempted_at], map: "idx_login_attempts")
  @@ignore
}

model member_deals {
  id                  String    @id @db.Uuid
  member_id           String?   @db.Uuid
  partner_member_name String?   @db.VarChar(255)
  title               String    @db.VarChar(255)
  deal_value          Decimal?  @default(0) @db.Decimal(12, 2)
  deal_date           DateTime? @db.Date
  notes               String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  members             Member?   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model settings {
  key   String @id @db.VarChar(100)
  value String
}

model status_history {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id   String    @db.Uuid
  from_status String?   @db.VarChar(20)
  to_status   String    @db.VarChar(20)
  reason      String?
  changed_at  DateTime? @default(now()) @db.Timestamp(6)
  author_name String?   @db.VarChar(255)
  members     Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([member_id, changed_at(sort: Desc)], map: "idx_status_history_member")
}

model user_permissions {
  user_id    String @db.Uuid
  permission String @db.VarChar(50)
  users      User   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, permission])
}



// ---------------------------------------------------------------------------
// F1 — CRM. Tabelas criadas por prisma/migrations/f1-crm/migration.sql.
// Nomes em camelCase com @map: sao estes models que o codigo TypeScript usa.
// ---------------------------------------------------------------------------

model Pipeline {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  isDefault      Boolean  @default(false) @map("is_default")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stages       Stage[]

  @@index([organizationId, position], map: "pipelines_org_idx")
  @@map("pipelines")
}

model Stage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  name       String   @db.VarChar(150)
  /// Barra colorida no topo da coluna do Kanban.
  colorHex   String   @default("#2563EB") @map("color_hex") @db.VarChar(20)
  position   Int      @default(0)
  /// Etapas terminais nao contam como oportunidade em aberto.
  isWon      Boolean  @default(false) @map("is_won")
  isLost     Boolean  @default(false) @map("is_lost")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  pipeline Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cards    DealCard[]

  @@index([pipelineId, position], map: "stages_pipeline_idx")
  @@map("stages")
}

model Contact {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  /// E.164 sem "+" (ex.: 5511987654321). Normalizado por lib/crm/phone.ts.
  phone          String?  @db.VarChar(30)
  email          String?  @db.VarChar(150)
  documentCpf    String?  @map("document_cpf") @db.VarChar(20)
  avatarUrl      String?  @map("avatar_url")
  company        String?  @db.VarChar(200)
  /// LEAD | CUSTOMER | PARTNER
  type           String   @default("LEAD") @db.VarChar(20)
  source         String?  @db.VarChar(50)
  notes          String?
  /// Campos livres da pessoa; o No de Captura do bot (F6) grava aqui.
  customFields   Json?    @map("custom_fields")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deals         DealCard[]
  tags          ContactTag[]
  activities    ActivityLog[]
  conversations Conversation[]

  @@index([organizationId, name], map: "contacts_org_name_idx")
  @@index([organizationId, email], map: "contacts_org_email_idx")
  @@map("contacts")
}

model DealCard {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  assignedUserId  String?   @map("assigned_user_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  /// WHATSAPP | INSTAGRAM | VOIP | WEBCHAT | WEBHOOK
  channel         String    @default("WHATSAPP") @db.VarChar(20)
  title           String    @db.VarChar(250)
  /// Decimal, nunca Float: 0.1 + 0.2 !== 0.3 em ponto flutuante.
  dealValue       Decimal   @default(0) @map("deal_value") @db.Decimal(12, 2)
  /// LOW | MEDIUM | HIGH | URGENT
  priority        String    @default("MEDIUM") @db.VarChar(20)
  position        Int       @default(0)
  lastMessageText String?   @map("last_message_text")
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamp(6)
  reminderAt      DateTime? @map("reminder_at") @db.Timestamp(6)
  slaDueAt        DateTime? @map("sla_due_at") @db.Timestamp(6)
  totalTasks      Int       @default(0) @map("total_tasks")
  completedTasks  Int       @default(0) @map("completed_tasks")
  /// Visivel apenas ao responsavel e a quem tem rank de Administrador para cima.
  isPrivate       Boolean   @default(false) @map("is_private")
  lostReason      String?   @map("lost_reason")
  /// Qualificacao do negocio: faturamento, gargalo, meta, urgencia.
  /// A F4 grava aqui o que a IA extrai da conversa, mesclando sem apagar.
  customFields    Json?     @map("custom_fields")
  /// Temperatura de 0 a 100 atribuida pela IA. Coluna propria, e nao dentro de
  /// customFields, porque precisa ser ordenavel e filtravel no quadro.
  aiScore         Int?      @map("ai_score") @db.SmallInt
  aiSummary       String?   @map("ai_summary")
  /// Quando a analise foi feita, para a interface nao apresentar um resumo
  /// antigo como se fosse de agora.
  aiAnalyzedAt    DateTime? @map("ai_analyzed_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stage         Stage          @relation(fields: [stageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUser  User?          @relation(fields: [assignedUserId], references: [id], onUpdate: NoAction)
  department    Department?    @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  activities    ActivityLog[]
  conversations Conversation[]

  @@index([stageId, position], map: "deal_cards_stage_idx")
  @@index([organizationId, stageId], map: "deal_cards_org_idx")
  @@index([organizationId, assignedUserId], map: "deal_cards_assigned_idx")
  @@index([contactId], map: "deal_cards_contact_idx")
  /// Ordenar o funil por temperatura. Parcial na migracao f4-ia: cards nunca
  /// analisados nao ocupam espaco, e sao a maioria.
  @@index([organizationId, aiScore(sort: Desc)], map: "deal_cards_ai_score_idx")
  @@map("deal_cards")
}

model Tag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  colorHex       String   @default("#64748B") @map("color_hex") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contacts     ContactTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contactId, tagId])
  @@index([tagId], map: "contact_tags_tag_idx")
  @@map("contact_tags")
}

model ActivityLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  dealCardId     String?  @map("deal_card_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  /// WHATSAPP | INSTAGRAM | VOIP | WEBCHAT | WEBHOOK | NOTE | SYSTEM
  channel        String   @default("WHATSAPP") @db.VarChar(20)
  title          String   @db.VarChar(250)
  /// Resumo estruturado gerado pela IA no encerramento do atendimento (F4).
  aiSummary      String?  @map("ai_summary")
  rawHistory     Json?    @map("raw_history")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealCard     DealCard?    @relation(fields: [dealCardId], references: [id], onUpdate: NoAction)
  user         User?        @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([contactId, createdAt(sort: Desc)], map: "activity_logs_contact_idx")
  @@map("activity_logs")
}

model Conversation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  dealCardId     String?   @map("deal_card_id") @db.Uuid
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  channel        String    @default("WHATSAPP") @db.VarChar(20)
  /// OPEN | PENDING | CLOSED
  status         String    @default("OPEN") @db.VarChar(20)
  /// Identificador da thread no gateway (ex.: JID do WhatsApp).
  externalId     String?   @map("external_id") @db.VarChar(150)
  unreadCount    Int       @default(0) @map("unread_count")
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamp(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dealCard     DealCard?    @relation(fields: [dealCardId], references: [id], onUpdate: NoAction)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onUpdate: NoAction)
  department   Department?  @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  messages     Message[]

  @@index([organizationId, status, lastMessageAt(sort: Desc)], map: "conversations_org_status_idx")
  /// Caixa de um atendente e a contagem que a distribuição por menor carga faz.
  @@index([organizationId, assignedUserId, status], map: "conversations_org_assigned_idx")
  /// Cursor do polling do Inbox: "o que mudou desde X", a cada 2 segundos.
  @@index([organizationId, updatedAt(sort: Desc)], map: "conversations_org_updated_idx")
  /// Caminho de findOrCreateConversation, em toda mensagem que entra.
  @@index([organizationId, contactId], map: "conversations_org_contact_idx")
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// Autor humano do lado da empresa; nulo quando veio do cliente ou do bot.
  userId         String?  @map("user_id") @db.Uuid
  /// INBOUND | OUTBOUND
  direction      String   @db.VarChar(10)
  /// TEXT | IMAGE | AUDIO | VIDEO | DOCUMENT | LOCATION | STICKER
  contentType    String   @default("TEXT") @map("content_type") @db.VarChar(20)
  content        String?
  mediaUrl       String?  @map("media_url")
  /// Transcricao de audio gerada na F4. Separada de `content` para preservar
  /// a distincao entre o que foi dito e o que a IA entendeu.
  transcription  String?
  /// NULL (nao tentado) | DONE | FAILED (vale repetir) | UNSUPPORTED.
  /// Sem este campo, um audio que falha seria retentado a cada abertura da
  /// conversa — uma chamada paga por abertura, para sempre.
  transcriptionStatus String? @map("transcription_status") @db.VarChar(20)
  /// PENDING | SCHEDULED | SENT | DELIVERED | READ | FAILED
  status         String   @default("SENT") @db.VarChar(20)
  externalId     String?  @map("external_id") @db.VarChar(150)
  isFromBot      Boolean  @default(false) @map("is_from_bot")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User?        @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([conversationId, createdAt], map: "messages_conversation_idx")
  @@map("messages")
}

/// Base de conhecimento da organizacao, que fundamenta o copiloto.
///
/// Sem ela, perguntado sobre preco o copiloto inventa um. Com ela, so pode
/// afirmar o que a empresa escreveu. A chave primaria e a propria organizacao:
/// nao existem duas bases concorrentes para o mesmo tenant.
model AiSettings {
  organizationId String   @id @map("organization_id") @db.Uuid
  /// Texto livre, sem formato imposto: quem escreve conhece o negocio.
  knowledgeBase  String   @default("") @map("knowledge_base")
  /// Como a empresa fala com o cliente.
  tone           String   @default("")
  /// Desliga a IA da organizacao inteira sem mexer em codigo.
  enabled        Boolean  @default(true)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ai_settings")
}
